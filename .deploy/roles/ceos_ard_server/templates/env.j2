# Managed by Ansible ({{ app_name }} role). Local edits are overwritten.
# Secrets come from host_vars/<host>/vault.yml.

CLIENT_URL={{ app_client_url }}
SERVER_URL={{ app_server_url }}
CORS_ORIGINS={{ app_cors_origins }}
ENVIRONMENT={{ app_environment }}

CEOS_ARD_ORG={{ app_ceos_ard_org }}
CEOS_ARD_REPO={{ app_ceos_ard_repo }}

GITHUB_CLIENT_ID={{ vault_github_client_id }}
GITHUB_CLIENT_SECRET={{ vault_github_client_secret }}
GITHUB_SERVICE_TOKEN={{ vault_github_service_token }}
GITHUB_SERVICE_TOKEN_EXPIRES_AT={{ vault_github_service_token_expires_at }}

GOOGLE_CLIENT_ID={{ vault_google_client_id | default('') }}
GOOGLE_CLIENT_SECRET={{ vault_google_client_secret | default('') }}

SECRET_KEY={{ vault_secret_key }}

DATABASE_URL={{ app_database_url }}
WORKSPACES_ROOT={{ app_workspaces_root }}

ALERT_EMAIL_TO={{ app_alert_email_to }}
ALERT_EMAIL_FROM={{ app_alert_email_from }}
SMTP_HOST={{ app_smtp_host }}
SMTP_PORT={{ app_smtp_port }}
SMTP_MODE={{ app_smtp_mode }}
SMTP_USER={{ app_smtp_user }}
SMTP_PASSWORD={{ vault_smtp_password | default('') }}
